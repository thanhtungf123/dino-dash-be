# Mẫu biến môi trường. Trên Railway, khai báo các biến này trong tab "Variables"
# (KHÔNG commit .env thật).

# Railway tự cấp PORT — thường không cần đặt tay.
PORT=3001

# Chuỗi kết nối MongoDB Atlas (KHÔNG dùng localhost khi lên production).
# Ví dụ: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/trex_game
MONGODB_URI=

# Khoá ký JWT — chuỗi ngẫu nhiên dài, giữ bí mật.
JWT_SECRET=

# Domain frontend (đã deploy) để bật CORS kèm cookie. Không có dấu "/" ở cuối.
# Có thể khai báo NHIỀU origin, ngăn cách bằng dấu phẩy.
# Ví dụ: https://a.vercel.app,https://b.vercel.app
FRONTEND_ORIGIN=

# (Tuỳ chọn) Cho phép mọi URL preview *.vercel.app gọi API. Đặt "true" nếu cần.
ALLOW_VERCEL_PREVIEWS=false

# Bật chế độ production: dùng cookie cross-site (SameSite=None; Secure).
NODE_ENV=production

# Tài khoản được cấp quyền admin (sửa nội dung Giới thiệu / Phần thưởng).
# Nhiều tài khoản ngăn cách bằng dấu phẩy. Ví dụ: tungne,admin2
ADMIN_USERNAMES=

# Cloudinary — lưu ảnh favicon/logo do admin upload (lấy ở Cloudinary Dashboard).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
